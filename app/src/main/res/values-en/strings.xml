    <!-- Tutorial Screen -->
    <string name="tutorial_title">User Guide</string>
    <string name="tut_section_quickstart">Quick Start</string>
    <string name="tut_section_advanced">Advanced</string>

    <string name="tut_1_title">Root Access</string>
    <string name="tut_1_path">Root Manager → Allow su</string>
    <string name="tut_1_p1">Grant su permission in Magisk, KernelSU, or APatch on first launch.</string>
    <string name="tut_1_p2">Return to Profiles and confirm the top status card turns active.</string>

    <string name="tut_2_title">Background Keep-Alive</string>
    <string name="tut_2_path_1">Battery → Unrestricted</string>
    <string name="tut_2_path_2">Recents → Lock App</string>
    <string name="tut_2_p1">Disable battery optimization so triggers keep running while screen is off.</string>
    <string name="tut_2_p2">Lock FluxCore in Android Recents to avoid background cleanup.</string>
    <string name="tut_btn_app_info">Open App Info</string>

    <string name="tut_3_title">Action Order &amp; Peak Brightness</string>
    <string name="tut_3_path">Action Card → Drag Left Handle</string>
    <string name="tut_3_p1">Drag the left handle to reorder steps and insert optional delays.</string>
    <string name="tut_3_p2">Auto-revert snapshots and restores volume, brightness, and refresh rate.</string>
    <string name="tut_3_p3">HBM peak brightness always reverts on rule exit or screen off.</string>

    <string name="tut_4_title">Tiles &amp; Shortcuts</string>
    <string name="tut_4_path">Rule Menu → Quick Settings / Home Screen</string>
    <string name="tut_4_p1">Bind up to 6 Quick Settings tile slots for one-tap toggling.</string>
    <string name="tut_4_p2">Pin Home Screen shortcuts to run or revert rules without opening the app.</string>

    <string name="tut_5_title">Local Scripts &amp; Live Logs</string>
    <string name="tut_5_path">Shell Action → Scan Scripts</string>
    <string name="tut_5_p1">Browse local .sh files with read-only preview before referencing or inserting.</string>
    <string name="tut_5_p2">Filter events and HBM sysfs node hits in real time from the Logs tab.</string>

    <string name="tut_6_title">Backup &amp; Upgrades</string>
    <string name="tut_6_path">Settings → Export / Import Config</string>
    <string name="tut_6_p1">Back up rules as .json with merge or overwrite restore (v1.2.0 compatible).</string>
    <string name="tut_6_p2">After installing an update, force-stop and reopen once to reload the service.</string>

